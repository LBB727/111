.profile-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 40rpx 64rpx;
}

.profile-section {
  padding: 30rpx 0;
  border-top: 2rpx solid #e5e1d8;
}

.profile-section__title {
  display: block;
  margin-bottom: 20rpx;
  color: #2f332f;
  font-size: 29rpx;
  font-weight: 600;
}

.profile-error {
  display: block;
  margin-top: 12rpx;
  color: #a35449;
  font-size: 24rpx;
}

.profile-error--choice {
  margin-top: -24rpx;
  margin-bottom: 18rpx;
}

.profile-page__continue {
  width: 100%;
  margin-top: 28rpx;
}

.profile-page__continue::after { border: 0; }
