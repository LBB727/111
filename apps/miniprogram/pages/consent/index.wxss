.consent-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 40rpx 64rpx;
}

.local-note {
  display: flex;
  align-items: flex-start;
  margin-bottom: 38rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(97, 117, 96, 0.32);
  border-radius: 20rpx;
  background: rgba(225, 231, 220, 0.46);
}

.local-note__icon {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin: 4rpx 20rpx 0 0;
}

.local-note__copy {
  display: flex;
  flex-direction: column;
}

.local-note__title {
  color: #465a47;
  font-size: 29rpx;
  font-weight: 600;
}

.local-note__description {
  margin-top: 8rpx;
  color: #6f756e;
  font-size: 25rpx;
  line-height: 1.6;
}

.consent-list {
  display: block;
  border-top: 2rpx solid #e5e1d8;
}

.consent-item {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 10rpx 4rpx;
  border-bottom: 2rpx solid #e5e1d8;
}

.consent-item checkbox {
  flex: none;
  margin-right: 18rpx;
  transform: scale(0.92);
}

.consent-item__text {
  color: #2f332f;
  font-size: 28rpx;
  line-height: 1.55;
}

.consent-page__continue {
  width: 100%;
  margin-top: 54rpx;
  border-radius: 26rpx;
}

.consent-page__continue::after {
  border: 0;
}
